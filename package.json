{
  "name": "@redsift/sift-sdk-web",
  "version": "2.0.3",
  "description": "SDK for developing web-based Sifts.",
  "main": "dist/sift-sdk-web.umd.js",
  "module": "dist/sift-sdk-web.mjs",
  "browser": "dist/sift-sdk-web.umd.js",
  "exports": {
    ".": {
      "import": "./dist/sift-sdk-web.mjs",
      "require": "./dist/sift-sdk-web.umd.js",
      "default": "./dist/sift-sdk-web.umd.js"
    },
    "./react": {
      "import": "./dist/react.mjs",
      "require": "./dist/react.umd.js",
      "default": "./dist/react.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "react.js"
  ],
  "scripts": {
    "build": "npm run clean && rollup --config rollup.config.mjs",
    "clean": "rm -rf ./dist",
    "prepare": "npm run build && husky",
    "pretest": "npm run build",
    "test": "node test/smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write src/ test/ *.mjs"
  },
  "keywords": [
    "redsift",
    "sift",
    "frontend"
  ],
  "author": "Martin Hecher <martin@redsift.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.9.6",
    "@redsift/observable": "^4.0.5",
    "@redsift/rs-storage": "^4.0.5",
    "js-sha256": "^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "rollup": "^4.63.1"
  },
  "peerDependencies": {
    "react": ">=16.13.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx}": "eslint --cache --fix",
    "*.{js,jsx,css,md}": "prettier --write"
  }
}
