{
  "name": "@redsift/sift-sdk-web",
  "version": "3.0.0",
  "description": "SDK for developing web-based Sifts.",
  "main": "dist/sift-sdk-web.mjs",
  "module": "dist/sift-sdk-web.mjs",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./dist/sift-sdk-web.mjs"
    },
    "./react": {
      "types": "./types/react.d.ts",
      "import": "./dist/react.mjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "sideEffects": false,
  "files": [
    "CHANGELOG.md",
    "dist",
    "types"
  ],
  "scripts": {
    "build": "npm run clean && rollup --config rollup.config.mjs",
    "clean": "rm -rf ./dist",
    "prepare": "npm run build && husky",
    "pretest": "npm run build",
    "test": "node test/smoke.mjs && node test/export-parity.mjs && node test/hook-parity.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/ test/ *.mjs *.md"
  },
  "keywords": [
    "redsift",
    "sift",
    "frontend"
  ],
  "author": "Martin Hecher <martin@redsift.io>",
  "license": "MIT",
  "engines": {
    "node": ">=18.18.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "@redsift/observable": "^4.0.5",
    "@redsift/rs-storage": "^4.0.5",
    "js-sha256": "^1.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "react-dom": "^18.3.1",
    "react-test-renderer": "^18.3.1",
    "rollup": "^4.63.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "react": ">=16.13.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{js,jsx,mjs,cjs}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{css,md}": "prettier --write"
  }
}
